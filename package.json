{
  "name": "gh-latest",
  "version": "1.3.60127",
  "description": "A simple tool to fetch the latest version from GitHub.",
  "main": "latest.js",
  "scripts": {
    "start": "bun latest.js",
    "build:linux": "bun build --compile --target=bun-linux-x64 latest.js --outfile latest",
    "build:win": "bun build --compile --target=bun-windows-x64 latest.js --outfile latest.exe",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64 latest.js --outfile latest-macos-x64",
    "build:mac-arm64": "bun build --compile --target=bun-darwin-arm64 latest.js --outfile latest-macos-arm64"
  },
  "engines": {
    "bun": ">= 1.0"
  },
  "keywords": [
    "github",
    "releases",
    "utility",
    "tool"
  ],
  "author": "Appurist Software <dev@appurist.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appurist/github-latest.git"
  },
  "bugs": {
    "url": "https://github.com/appurist/github-latest/issues"
  },
  "homepage": "https://github.com/appurist/github-latest#readme",
  "dependencies": {
    "yauzl": "^3.2.0"
  }
}
